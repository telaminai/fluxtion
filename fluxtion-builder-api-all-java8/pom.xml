<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.telamin.fluxtion</groupId>
        <artifactId>fluxtion-parent</artifactId>
        <version>1.0.14</version>
    </parent>

    <artifactId>fluxtion-builder-api-all-java8</artifactId>
    <name>telamin :: fluxtion-builder-api-all-java8</name>
    <description>
        Self-contained Java 8 artifact containing the open Fluxtion authoring API and runtime.
    </description>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <asm.version>9.7</asm.version>
        <retrolambda.version>2.5.7</retrolambda.version>
        <jdk8.home>${user.home}/.sdkman/candidates/java/8.0.492-zulu</jdk8.home>
        <fluxtion.skipRetrolambda>false</fluxtion.skipRetrolambda>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.agrona</groupId>
            <artifactId>agrona</artifactId>
            <version>1.21.2</version>
        </dependency>
        <dependency>
            <groupId>com.telamin.fluxtion</groupId>
            <artifactId>fluxtion-builder-api</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.agrona</groupId>
                    <artifactId>agrona</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
            <version>${asm.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-tree</artifactId>
            <version>${asm.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.orfjackal.retrolambda</groupId>
            <artifactId>retrolambda</artifactId>
            <version>${retrolambda.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Kryo removed (remove-meta Phase 4): no class in the repackaged runtime/builder-api set references it
             any more — serialization moved to fluxtion-builder with its own Kryo dependency. -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <minimizeJar>false</minimizeJar>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/versions/**</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>com.telamin.fluxtion:fluxtion-builder-api</artifact>
                                    <excludes>
                                        <exclude>com/telamin/fluxtion/builder/DataFlowBuilder.class</exclude>
                                        <exclude>com/telamin/fluxtion/builder/flowfunction/FlowDataSupplier.class</exclude>
                                        <exclude>com/telamin/fluxtion/builder/flowfunction/JoinFlowBuilder.class</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>${project.groupId}:${project.artifactId}</artifact>
                                    <excludes>
                                        <exclude>com/telamin/fluxtion/web/buildtools/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.1</version>
                <executions>
                    <execution>
                        <id>retro-pipeline</id>
                        <phase>package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${fluxtion.skipRetrolambda}</skip>
                            <executable>java</executable>
                            <classpathScope>compile</classpathScope>
                            <arguments>
                                <argument>-classpath</argument>
                                <classpath />
                                <argument>-Djdk8.home=${jdk8.home}</argument>
                                <argument>-Dretrolambda.jar=${settings.localRepository}/net/orfjackal/retrolambda/retrolambda/${retrolambda.version}/retrolambda-${retrolambda.version}.jar</argument>
                                <argument>com.telamin.fluxtion.web.buildtools.RetroPipeline</argument>
                                <argument>${project.build.directory}/${project.build.finalName}.jar</argument>
                                <argument>${project.build.directory}/${project.build.finalName}.jar</argument>
                                <argument>${maven.multiModuleProjectDirectory}/fluxtion-runtime/target/fluxtion-runtime-${project.version}.jar</argument>
                                <argument>${settings.localRepository}/org/agrona/agrona/1.21.2/agrona-1.21.2.jar</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
